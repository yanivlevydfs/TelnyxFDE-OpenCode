# Local development configuration. Copy to `.env` (git-ignored) and fill in.
# In production every value below is an Edge secret:
#     telnyx-edge secrets add <NAME> <VALUE>
# Secrets are org-scoped and injected as env vars into ALL functions.

# --- Shared by Python services ---------------------------------------------
TELNYX_API_KEY=                 # injected automatically on Edge by [telnyx] binding
TELNYX_API_BASE=https://api.telnyx.com/v2
KV_NAMESPACE_ID=                # from `telnyx-edge storage kv create --name fde-kv`
ACTOR_SERVICE_URL=              # https://fde-session-actor-<id>.telnyxcompute.com
INTERNAL_API_TOKEN=             # random string; shared by all services (actor facade auth)
TRACE_HEADER=x-trace-id
HTTP_TIMEOUT_MS=1000

# --- webhook ----------------------------------------------------------------
TELNYX_PUBLIC_KEY=              # Mission Control -> Keys & Credentials -> Public Key
WEBHOOK_VERIFY_SIGNATURE=true   # false ONLY for local curl testing
WEBHOOK_TOLERANCE_SECS=300
WEBHOOK_BUDGET_MS=1200          # keep below assistant dynamic_variables_webhook_timeout_ms
KV_FLAGS_KEY=flags/assistant      # JSON of scalar flags, e.g. {"deals_enabled": true}
SESSION_KEY_PREFIX=session/
SESSION_TTL_SECS=3600

# --- mcp-server ---------------------------------------------------------------
MCP_API_KEY=                    # random string; also stored as Telnyx integration secret (api_key_ref)
MCP_SERVER_NAME=telnyx-fde-mcp
MCP_SERVER_VERSION=0.1.0
FLYTLV_API_BASE=https://flytlv.app
FLYTLV_API_KEY=                 # flytlv private feed key (X-API-Key header)
DEALS_RESULT_LIMIT=3            # deals read aloud per search
DEALS_CACHE_TTL_SECS=600
