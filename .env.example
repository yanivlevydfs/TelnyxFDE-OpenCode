# Local configuration for tests, scripts and provisioning. Copy to `.env`
# (git-ignored) and fill in. On Telnyx Edge the secrets below are Edge secrets
# (`telnyx-edge secrets add <NAME> <VALUE>`, org-scoped, injected as env vars);
# non-secret knobs live in each service's func.toml / telnyx.toml [env_vars].

# --- secrets (Edge secrets in production) -----------------------------------
TELNYX_API_KEY=                 # injected on Edge by the [telnyx] binding; used locally by provision.py
TELNYX_PUBLIC_KEY=              # Ed25519 key for webhook signatures (Portal -> Keys & Credentials)
KV_NAMESPACE_ID=                # `telnyx-edge storage kv create --name fde-kv`
ACTOR_SERVICE_URL=              # https://fde-session-actor-<id>.telnyxcompute.com
INTERNAL_API_TOKEN=             # random string; webhook + MCP -> actor facade bearer
MCP_API_KEY=                    # random string; assistant -> MCP bearer (integration secret)
FLYTLV_API_KEY=                 # flytlv.app private deals feed (X-API-Key)

# --- shared ------------------------------------------------------------------
TRACE_HEADER=x-trace-id         # header carrying the trace id to the actor
HTTP_TIMEOUT_MS=1000            # outbound HTTP timeout (webhook)
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
LOG_TIMEZONE=Asia/Jerusalem     # timezone of the "ts" field in every log line

# --- webhook -----------------------------------------------------------------
WEBHOOK_VERIFY_SIGNATURE=true   # false ONLY for local curl testing
WEBHOOK_BUDGET_MS=1200          # below the assistant's dynamic_variables_webhook_timeout_ms
KV_FLAGS_KEY=flags/assistant    # JSON flags, e.g. {"deals_enabled": true, "sms_enabled": true, "promo": ""}
SESSION_KEY_PREFIX=session/
SESSION_TTL=3600

# --- mcp-server ----------------------------------------------------------------
MCP_SERVER_NAME=fde-mcp
FLYTLV_API_BASE=https://flytlv.app
FLYTLV_DEALS_PATH=/api/private/deals
FLYTLV_API_KEY_HEADER=X-API-Key
FLYTLV_TIMEOUT_MS=3000
DEALS_FETCH_LIMIT=20            # deals pulled per query
DEALS_COUNTRY_FETCH_LIMIT=300   # deals pulled when filtering by country
DEALS_RESULT_LIMIT=5            # deals read aloud / remembered
DEALS_CACHE_TTL=300             # seconds
DEALS_CACHE_PREFIX=cache/deals/
CALLER_TIMEZONE=Asia/Jerusalem  # weekend dates and the departure cutoff
MIN_HOURS_BEFORE_DEPARTURE=3    # hide flights leaving sooner than this
SMS_FROM=FlyTLV                 # alphanumeric SMS sender
MESSAGING_PROFILE_ID=           # Telnyx messaging profile for SMS

# --- assistant provisioning (assistant/provision.py) ---------------------------
WEBHOOK_URL=                    # https://fde-webhook-<id>.telnyxcompute.com/
MCP_URL=                        # https://fde-mcp-<id>.telnyxcompute.com/
ASSISTANT_MODEL=zai-org/GLM-5.3-Flash   # must be recommended_for_assistants
ASSISTANT_VOICE=Telnyx.KokoroTTS.af_heart
ASSISTANT_NAME=FlyTLV Travel Line
ASSISTANT_ID=                   # set to update the existing assistant instead of creating one
MCP_SERVER_ID=                  # set to reuse the registered MCP server
MCP_API_KEY_REF=flytlv-mcp-key  # integration secret identifier
ASSISTANT_PHONE_NUMBER_ID=      # number to link to the assistant
ASSISTANT_CONNECTION_ID=        # optional; read from the assistant if empty
TRANSFER_TO_NUMBER=             # E.164 human agent number; empty = no transfer tool
CONVERSATION_TIMEOUT_SECS=600   # offer a human after this many seconds
WEBHOOK_TIMEOUT_MS=1500         # dynamic_variables_webhook_timeout_ms
