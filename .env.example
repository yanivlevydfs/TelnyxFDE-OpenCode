# Local configuration for tests, scripts and provisioning. Copy to `.env`
# (git-ignored) and fill in. Local scripts (scripts/ops/*.py, assistant/provision.py)
# load this file automatically at start-up via shared/common.load_env(), without
# overriding variables already set; the webhook never reads it (it runs on
# Telnyx Edge). On Edge the secrets below are Edge secrets
# (`telnyx-edge secrets add <NAME> <VALUE>`, org-scoped, injected as env vars);
# non-secret knobs live in each service's func.toml / telnyx.toml [env_vars].
#
# This file lists EVERY environment variable any Python or TypeScript source in
# the repo reads (services, shared, assistant, scripts), grouped by component,
# each with the code's current default value (or empty for secrets / per-account
# ids) and a one-line comment. Prompt/speak-node text, tool names, storage key
# names and regexes are code/content, not settings — they stay in code.

# --- secrets (Edge secrets in production) -----------------------------------
# Marked `secret:` here; never carry a value in this file. Set on Edge with:
#   telnyx-edge secrets add <NAME> <VALUE>
TELNYX_API_KEY=                 # secret: set with telnyx-edge secrets add — injected on Edge by the [telnyx] binding; used locally by provision.py and scripts/ops
TELNYX_PUBLIC_KEY=              # secret: set with telnyx-edge secrets add — Ed25519 key for webhook signatures (Portal -> Keys & Credentials)
KV_NAMESPACE_ID=                # secret: set with telnyx-edge secrets add — `telnyx-edge storage kv create --name fde-kv`
ACTOR_SERVICE_URL=              # secret: set with telnyx-edge secrets add — session-actor Edge Function URL (HTTP facade for the webhook / ops / ActorClient fallback)
INTERNAL_API_TOKEN=             # secret: set with telnyx-edge secrets add — bearer the webhook + MCP and the ops scripts send to the actor facade
MCP_API_KEY=                    # secret: set with telnyx-edge secrets add — bearer the assistant sends to the MCP server (registered as a Telnyx integration secret)
FLYTLV_API_KEY=                 # secret: set with telnyx-edge secrets add — flytlv.app private deals feed (sent as the X-API-Key header)

# --- shared (logging + tracing; shared/common.py + the TS loggers) -----------
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR (log line gate)
LOG_TIMEZONE=Asia/Jerusalem     # timezone of the "ts" field in every log line
TRACE_HEADER=x-trace-id         # header carrying the trace id to the actor
HTTP_TIMEOUT_MS=1000            # outbound HTTP timeout in ms (webhook actor calls; mcp-server reads its own default of 3000)

# --- webhook (Dynamic Variables Edge Function, Python) ----------------------
WEBHOOK_VERIFY_SIGNATURE=true   # false ONLY for local curl testing
WEBHOOK_BUDGET_MS=2500          # fan-out budget; below dynamic_variables_webhook_timeout_ms (8000)
KV_FLAGS_KEY=flags/assistant    # JSON flags, e.g. {"deals_enabled": true, "sms_enabled": true, "promo": ""}
FLAGS_CACHE_SECS=60             # seconds the KV flags are cached in-process (per client)
SESSION_KEY_PREFIX=session/     # maps a conversation id to the caller's entity id; read by the mcp-server too
SESSION_TTL=3600                # TTL of the session map entry (seconds)

# --- mcp-server (MCP Edge Function, TypeScript) -----------------------------
MCP_SERVER_NAME=fde-mcp         # MCP server display name (provision.py also reads it, default there flytlv-mcp)
USE_SHARED_ACTOR=true           # bind CallerSession directly via SESSIONS; "false" -> ActorClient HTTP fallback
PORT=8080                       # local npm start only; Telnyx Edge injects its own; never declare it in func.toml
FLYTLV_API_BASE=https://flytlv.app
FLYTLV_DEALS_PATH=/api/private/deals
FLYTLV_FLIGHTS_PATH=/api/private/flights      # one-way flights feed path (round trips use FLYTLV_DEALS_PATH)
FLYTLV_API_KEY_HEADER=X-API-Key
FLYTLV_TIMEOUT_MS=3000          # short: a phone caller is on the line (one retry on timeout)
DEALS_FETCH_LIMIT=20            # deals pulled per simple search
DEALS_BROAD_FETCH_LIMIT=300     # deals pulled for a country/category/weekend/discount search
DEALS_COUNTRY_FETCH_LIMIT=300   # fallback default for DEALS_BROAD_FETCH_LIMIT when the latter is unset
DEALS_RESULT_LIMIT=5            # deals read aloud / remembered per call
DEALS_CACHE_TTL=300             # seconds; flytlv caches ~10 min server-side
DEALS_CACHE_PREFIX=cache/deals/
SESSION_KEY_PREFIX=session/     # written by the webhook, read by the tools (same value as the webhook)
KV_FLAGS_KEY=flags/assistant    # best-effort SMS enable flag (same value as the webhook)
CALLER_TIMEZONE=Asia/Jerusalem  # weekend dates and the departure cutoff
MIN_HOURS_BEFORE_DEPARTURE=3    # hide flights leaving sooner than this
SMS_FROM=FlyTLV                 # alphanumeric SMS sender; also forwarded to the actor on every saveDeal
MESSAGING_PROFILE_ID=           # Telnyx messaging profile for SMS; also forwarded to the actor on every saveDeal
ITINERARY_BASE_URL=             # public prefix for itinerary pages; forwarded to the actor on every saveDeal
REMINDER_DELAY_SECONDS=600      # delay before the follow-up reminder SMS; forwarded to the actor on every saveDeal
ITINERARY_SLOTS=4                # fixed itinerary slot keys; forwarded to the actor on every saveDeal (step 22)
STORAGE_MAX_OBJECTS=5            # hard bucket object limit; forwarded to the actor on every saveDeal (guard: slots+1<=max)

# --- session-actor (Stateful Actors + HTTP facade, TypeScript) ----------------
# NOTE: the umbrella telnyx.toml [env_vars] below do NOT reach actor instances'
# process.env in production (live finding, step 11). The MCP server forwards
# ITINERARY_BASE_URL, REMINDER_DELAY_SECONDS, SMS_FROM and MESSAGING_PROFILE_ID
# on every saveDeal call; the values below are the unit-test / local-dev fallback
# (and the source of truth once the platform honours the actor umbrella).
MAX_SAVED_DEALS=50              # saved deals kept per caller
AUDIT_PREFIX=audit/             # legacy — audit now writes one object audit/latest.json (step 22); kept for compatibility
SEARCH_HISTORY_MAX=50           # entries kept in the per-caller searchHistory timeline
ITINERARY_SLOTS=4                # fixed itinerary slot keys (step 22); a caller maps to a stable hash mod SLOTS
STORAGE_MAX_OBJECTS=5            # hard bucket object limit (step 22); guard: ITINERARY_SLOTS + 1 <= STORAGE_MAX_OBJECTS
AUDIT_ENABLED=true              # "false" turns off audit writes to the AuditLog actor (history is still kept)
AUDIT_MAX_EVENTS=200             # events kept by the AuditLog actor in storage and written to audit/latest.json
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR (session-actor log line gate)
LOG_TIMEZONE=Asia/Jerusalem     # timezone of the "ts" field in actor log lines
TRACE_HEADER=x-trace-id         # inbound trace header (read from the request header)
SMS_FROM=FlyTLV                 # reminder SMS sender (fallback when not forwarded by the MCP server)
MESSAGING_PROFILE_ID=           # reminder messaging profile (fallback when not forwarded by the MCP server)
ITINERARY_BASE_URL=             # public prefix for itinerary pages (fallback; set in telnyx.toml [env_vars])
REMINDER_DELAY_SECONDS=600      # delay before the follow-up reminder SMS (fallback; set in telnyx.toml [env_vars])

# --- assistant provisioning (assistant/provision.py) ---------------------------
WEBHOOK_URL=                    # https://fde-webhook-<id>.telnyxcompute.com/
MCP_URL=                        # https://fde-mcp-<id>.telnyxcompute.com/
ASSISTANT_MODEL=zai-org/GLM-5.3-Flash   # must be recommended_for_assistants on Telnyx Inference
ASSISTANT_VOICE=Telnyx.KokoroTTS.af_heart
ASSISTANT_NAME=FlyTLV Travel Line
ASSISTANT_DESCRIPTION=FlyTLV Travel Line — cheap flights from Tel Aviv by phone, round trip or one way.
ASSISTANT_ID=                   # set to UPDATE the existing assistant instead of creating a new one
ASSISTANT_PHONE_NUMBER=         # assistant's own number used as the transfer caller-id; also a fallback for ASSISTANT_PHONE_NUMBER_ID
ASSISTANT_PHONE_NUMBER_ID=      # phone number id to link to the assistant (preferred over ASSISTANT_PHONE_NUMBER)
ASSISTANT_CONNECTION_ID=        # optional voice connection id; read from the assistant record if empty
MCP_SERVER_ID=                  # set to REUSE the registered MCP server instead of adding another
MCP_API_KEY_REF=flytlv-mcp-key  # integration secret identifier holding the MCP bearer token
TRANSFER_TO_NUMBER=             # E.164 human agent number; empty = no transfer tool
TRANSFER_TO_NAME=               # the human's name, said by the assistant (e.g. Ofek)
CONVERSATION_TIMEOUT_SECS=600   # offer a human after this many seconds (timeout expression edge)
WEBHOOK_TIMEOUT_MS=8000         # dynamic_variables_webhook_timeout_ms (~8 s for Edge cold starts)
HANGUP_TOOL_ID=                 # reuse an existing shared hangup tool by id; empty = create one
HANGUP_TOOL_NAME=flytlv-end-call  # display name for the created hangup tool
INSIGHT_GROUP_ID=               # "FlyTLV caller intent" insight group id; empty in --dry-run, set during real provisioning
INSIGHT_GROUP_NAME=FlyTLV caller intent  # insight group name (created or reused by name on re-runs)

# --- scripts/ops (live checks + maintenance) ---------------------------------
LIVE_CHECK_CALLER=18880000000   # fixed test caller number for live_check.py so runs reuse the same itinerary slot
STORAGE_S3_ENDPOINT=https://telnyxcloudstorage.com  # Telnyx Cloud Storage S3 API endpoint (for storage_check.py)
STORAGE_S3_ACCESS_KEY=          # secret: S3 access key for Listing the bucket (storage_check.py)
STORAGE_S3_SECRET_KEY=          # secret: S3 secret key for Listing the bucket (storage_check.py)
STORAGE_S3_REGION=us-central-1  # S3 region of the flytlv-itineraries bucket
STORAGE_BUCKET=flytlv-itineraries  # Cloud Storage bucket name (itinerary slots + audit)
